# Database Connection string (PostgreSQL 16)
# For local Docker Compose / local Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lazarus

# Tunables per PRD section 8
LEASE_SECONDS=6
HEARTBEAT_SECONDS=2
WORKER_CONCURRENCY=4
POLL_INTERVAL=0.3
MAX_ATTEMPTS=5
BACKOFF_BASE=1.5
BACKOFF_CAP=20.0
POISON_THRESHOLD=3
REAPER_INTERVAL=2.0

# Port configuration
PORT=8000
HOST=0.0.0.0

# Safety Guard for Demo Reset (refuses /api/chaos/reset unless set to 1)
LAZARUS_ALLOW_RESET=1
